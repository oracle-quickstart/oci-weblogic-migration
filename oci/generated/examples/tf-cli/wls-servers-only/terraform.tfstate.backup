      "instances": [
        {
          "index_key": "testdomain-vms-0",
          "schema_version": 0,
          "attributes": {
            "id": "7114117196074645654",
            "triggers": {
              "update_config_commands": "\"#!/usr/bin/env bash\\n# Copyright (c) 2024 Oracle Corporation and/or its affiliates.\\n# Licensed under the Universal Permissive License v 1.0 as shown at https://oss.oracle.com/licenses/upl\\n# shellcheck disable=SC1091\\nset -o pipefail\\n\\n#Domain = /opt/domains/testdomain\\n#user = domain\\n#XPATH map old/new: object oci_host_listen_address\\n\\nLOG_FILE='wls_update_domain_config.log'\\n\\nfunction log(){\\n    timestamp=$(date +'%Y-%m-%d %H:%M:%S')\\n    level=$1\\n    message=$2\\n    echo \\\"$timestamp\\\" [\\\"${level^^}\\\"] \\\"$message\\\" | tee -a \\\"$LOG_FILE\\\"\\n}\\n\\n\\nfunction update_wls_config() {\\n    log \\\"info\\\" \\\"Attempting to update Weblogic Configuration with new hostnames\\\"\\n    \\n        sudo su - domain -c 'grep --include=\\\\*.{xml,properties} -rnl \\\"/opt/domains/testdomain\\\" -e \\\"lakemigcoherence-2.lakewlsprivates.lakevcn.oraclevcn.com\\\"' \\u003e\\u003e \\\"$LOG_FILE\\\" 2\\u003e\\u00261;\\n        sudo su - domain -c 'grep --include=\\\\*.{xml,properties} -rwl \\\"/opt/domains/testdomain\\\" -e \\\"lakemigcoherence-2.lakewlsprivates.lakevcn.oraclevcn.com\\\" | xargs sed -i \\\"s/lakemigcoherence-2.lakewlsprivates.lakevcn.oraclevcn.com/lakemigcoherence-2/g\\\"' \\u003e\\u003e \\\"$LOG_FILE\\\" 2\\u003e\\u00261;\\n    \\n        sudo su - domain -c 'grep --include=\\\\*.{xml,properties} -rnl \\\"/opt/domains/testdomain\\\" -e \\\"lakemigcoherence.lakewlsprivates.lakevcn.oraclevcn.com\\\"' \\u003e\\u003e \\\"$LOG_FILE\\\" 2\\u003e\\u00261;\\n        sudo su - domain -c 'grep --include=\\\\*.{xml,properties} -rwl \\\"/opt/domains/testdomain\\\" -e \\\"lakemigcoherence.lakewlsprivates.lakevcn.oraclevcn.com\\\" | xargs sed -i \\\"s/lakemigcoherence.lakewlsprivates.lakevcn.oraclevcn.com/lakemigcoherence/g\\\"' \\u003e\\u003e \\\"$LOG_FILE\\\" 2\\u003e\\u00261;\\n        log \\\"info\\\" \\\"Weblogic config updated.\\\"\\n}\\n\\n\\ntime update_wls_config || { echo \\\"Error Updating Weblogic configuration. Check logs.\\\" 1\\u003e\\u00262; exit 1; }\""
            }
          },
