data "oci_database_autonomous_database" "atp_db_{{{datasourceName}}}" {
  count                  = local.is_atp_db_{{{datasourceName}}} ? 1 : 0
  autonomous_database_id = var.atp_db_id_{{{datasourceName}}}
}

data "oci_database_db_systems" "ocidb_db_systems_{{{datasourceName}}}" {
  count          = local.is_oci_db_{{{datasourceName}}} ? 1 : 0
  compartment_id = var.oci_db_compartment_id_{{{datasourceName}}}
  filter {
    name   = "id"
    values = [var.oci_db_dbsystem_id_{{{datasourceName}}}]
  }
}


data "oci_database_database" "ocidb_database_{{{datasourceName}}}" {
  count       = local.is_ocidb_system_id_available_{{{datasourceName}}} ? 1 : 0
  database_id = var.oci_db_database_id_{{{datasourceName}}}
}


data "oci_database_db_home" "ocidb_db_home_{{{datasourceName}}}" {
  #  count      = local.is_ocidb_system_id_available_{{{datasourceName}}} && !local.is_db_deleted ? 1 : 0
  count      = local.is_ocidb_system_id_available_{{{datasourceName}}} ? 1 : 0
  #  db_home_id = data.oci_database_database.ocidb_database[0].db_home_id
  db_home_id = data.oci_database_database.ocidb_database_{{{datasourceName}}}[0].db_home_id
}

resource "time_sleep" "wait_for_wls_vcn_dns_resolver" {
  create_duration = "20s"
}

resource "oci_core_local_peering_gateway" "dblpg_{{{datasourceName}}}" {
  #count          = local.is_oci_db_{{{datasourceName}}} ? 1 : 0
  #Required
  compartment_id = var.oci_db_compartment_id_{{{datasourceName}}}
  display_name   = "dblpg_{{{datasourceName}}}"
  vcn_id = var.oci_db_existing_vcn_id_{{{datasourceName}}}
}

resource "oci_core_local_peering_gateway" "wlslpg_{{{datasourceName}}}" {
  #Required
  depends_on = [time_sleep.wait_for_wls_vcn_dns_resolver]
  compartment_id = var.network_compartment_id
  display_name   = "wlslpg_{{{datasourceName}}}"
  vcn_id = var.vcn_id
  peer_id = oci_core_local_peering_gateway.dblpg_{{{datasourceName}}}.id
}
