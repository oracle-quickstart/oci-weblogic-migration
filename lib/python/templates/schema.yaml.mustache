## VARIABLES Definitions
variables:
  # Stack Configuration
  create_oci_policies:
    title: OCI Policies
    description: "Create policies to read Object Storage Bucket and manage Autonomous Transaction Processing Database (if applicable). Deselecting this option is for Advanced users only.  Before you deselect the check box, see <a target=\"_blank\" href=\"https://docs.oracle.com/pls/topic/lookup?ctx=en/cloud/paas/weblogic-cloud&id=WLCUG-GUID-4E2AD7BF-592D-4C2C-AF66-D98CB26379A5\">Create Root Policies</a> to create the required groups and relevant policies."
    required: true
    type: boolean
    default: true
  # Identity
  current_user_ocid:
    title: User
    type: ocid
    required: true
  tenancy_ocid:
    title: Tenancy
    type: oci:identity:compartment:id
    required: true
  compartment_ocid:
    title: Compartment
    description: The default compartment for created resources.
    type: oci:identity:compartment:id
    required: true
  region:
    required: true
    title: Region
    type: oci:identity:region:name

  create_iam_tag_namespace:
    default: false
    required: true
    title: Create tag namespace
    type: boolean
  create_iam_defined_tags:
    default: false
    required: true
    title: Create defined tags
    type: boolean
  use_defined_tags:
    title: Use defined tags
    default: false
    type: boolean
  tag_namespace:
    title: Tag namespace
    visible: ${use_defined_tags}
  defined_tags:
    visible: false
  freeform_tags:
    visible: false

  # VCN
  create_vcn:
    visible: ${orm_create_mode}
    title: Create a Virtual Cloud Network
    type: boolean
    default: true
    description: Create a Virtual Cloud Network and subnets.
  network_compartment_id:
    visible: ${orm_create_mode}
    type: oci:identity:compartment:id
    title: "Network Compartment"
    description: "The compartment where you want to create the network resources such as Virtual Cloud Network, security lists, route tables and gateways."
    required: false
    default: ${compartment_ocid}
  vcn_id:
    title: Existing Virtual Cloud Network
    type: oci:core:vcn:id
    description: An existing Virtual Cloud Network (VCN) in which to create the compute instances, network resources, and load balancers.
    required: true
    dependsOn:
      compartmentId: ${network_compartment_id}
    visible:
      and:
        - ${orm_create_mode}
        - not:
          - ${create_vcn}
  vcn_name:
    title: "Virtual Cloud Network Name"
    description: Display name of the new Virtual Cloud Network (VCN). Defaults to 'wls' suffixed with the generated Terraform 'state_id' value.
    type: string
    visible: ${create_vcn}
    required: false
  assign_dns:
    title: Assign DNS records
    type: boolean
    default: true
    required: true
  vcn_dns_label:
    title: DNS label
    description: DNS label for the created VCN. Defaults to the generated Terraform 'state_id' value.
    visible: false
    required: false
  vcn_cidrs:
    type: string
    default: 10.0.0.0/16
    required: true
    pattern: "^(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]).(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]).(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]).(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\/(3[0-2]|[1-2]?[0-9])$"
    title: "Virtual Cloud Network CIDR"
    description: "The CIDR to assign to the new Virtual Cloud Network (VCN)."
    visible: ${create_vcn}
  lockdown_default_seclist:
    title: Secure default security list
    type: boolean
    required: true
    visible: ${create_vcn}
  vcn_create_internet_gateway:
    title: Create internet gateway
    type: boolean
    required: true
    visible: false
  vcn_create_nat_gateway:
    title: Create service gateway
    type: boolean
    required: true
    visible: false
  vcn_create_service_gateway:
    title: Create NAT gateway
    type: boolean
    required: true
    visible: false
  local_peering_gateways:
    title: Local peering gateways
    visible: false
  ig_route_table_id:
    title: Internet Gateway Route Table
    description: Existing Internet Gateway route table to attach to the VCN
    type: ocid
    required: false
    visible: false
    #  not:
    #    - ${create_vcn}
  service_gateway_id:
    title: Service gateway
    description: Existing service gateway in the VCN for access to Oracle Cloud services.
    type: oci:core:servicegateway:id
    required: true
    visible: false
    #  not:
    #    - ${create_vcn}
    dependsOn:
      compartmentId: ${network_compartment_id}
      vcnId: ${vcn_id}
  nat_gateway_id:
    title: NAT gateway
    description: Existing NAT gateway in the VCN for private network egress.
    type: oci:core:natgateway:id
    required: true
    visible: false
    #  not:
    #    - ${create_vcn}
    dependsOn:
      compartmentId: ${network_compartment_id}
      vcnId: ${vcn_id}

  #NSG
  create_nsgs:
    title: Create NSGs
    description: Create standard network security groups and traffic rules. Additional configuration may be required when disabled, e.g. providing existing NSGs, subnet security lists, etc.
    type: boolean
    default: true
    required: true
    visible: false
  managedserver_nsg_id:
    title: Weblogic Managed Server Network Security Group
    description: Network Security Groups for the created Weblogic Managed Server node(s), used to configure network access to instances. See <a href=https://docs.oracle.com/en-us/iaas/Content/ContEng/Concepts/contengnetworkconfig.htm#securitylistconfig>Security Rule Configuration in ... Network Security Groups</a> for more information.
    type: oci:core:nsg:id
    # additionalProps:
    #   allowMultiple: true
    required: false
    dependsOn:
      compartmentId: ${compartment_ocid}
      vcnId: ${vcn_id}
    visible: { not: [ create_nsgs ] }
  adminserver_nsg_id:
    title: Weblogic AdminServer Network Security Group
    description: Network Security Groups for the created AdminServer node, used to configure network access to instances. See <a href=https://docs.oracle.com/en-us/iaas/Content/ContEng/Concepts/contengnetworkconfig.htm#securitylistconfig>Security Rule Configuration in ... Network Security Groups</a> for more information.
    type: oci:core:nsg:id
    # additionalProps:
    #   allowMultiple: true
    required: false
    dependsOn:
      compartmentId: ${compartment_ocid}
      vcnId: ${vcn_id}
    visible: { not: [ create_nsgs ] }

  pub_lb_nsg_id:
    title: Attach existing NSG ?
    description: Network Security Groups for the created Public Load Balancer resource, used to configure network access to instances. See <a href=https://docs.oracle.com/en-us/iaas/Content/ContEng/Concepts/contengnetworkconfig.htm#securitylistconfig>Security Rule Configuration in ... Network Security Groups</a> for more information. Note - Select Option Existing VCN to discover and populate Drop Down
    type: oci:core:nsg:id
    required: true
    dependsOn:
      compartmentId: ${compartment_ocid}
      vcnId: ${vcn_id}
    visible:
      and:
        - add_load_balancer
        - not:
            - create_nsgs

  ########################################################################
  # Subnets
  wlsserver_subnet_create:
    title: Create Weblogic Server subnet
    type: boolean
    required: true
    visible: false
    default:  false
    description: Create new subnets in the existing Virtual Cloud Network

  wlsserver_subnet_newbits:
    title: Weblogic Server subnet size
    description: The number of network prefix bits added to the VCN CIDR block for the created subnet address range (i.e. a higher value is smaller). Refer to the Terraform <a href=https://developer.hashicorp.com/terraform/language/functions/cidrsubnets>cidrsubnets</a> function for more information.
    type: number
    visible:
      and:
        - ${orm_create_mode}
        - and:
             - or:
                - ${create_vcn}
                - ${wlsserver_subnet_create}

  wlsserver_subnet_cidr:
    visible: ${orm_create_mode}
    type: string
    default: 10.0.2.0/24
    pattern: "^(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]).(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]).(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]).(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\/(3[0-2]|[1-2]?[0-9])$"
    required: true
    title: "WebLogic Server Subnet CIDR"
    description: "The CIDR of the new subnet to create for WebLogic Server compute instances. In case of an existing VCN, the new subnet's CIDR should not overlap with any other subnet CIDRs."

  wlsserver_subnet_id:
    title: Existing WebLogic Server subnet
    description: "VCN subnet for the primary network interface of created WebLogic Server node(s). This subnet must already be present in the chosen VCN."
    type: oci:core:subnet:id
    required: true
    dependsOn:
      compartmentId: ${network_compartment_id}
      vcnId: ${vcn_id}
      hidePublicSubnet: true
      hidePrivateSubnet: false
      hideRegionalSubnet: false
      hideAdSubnet: true
    visible: false

  #Network Other
  wlsserver_is_public:
    title: Public WebLogic nodes
    type: boolean
    default: false
    required: true
    visible: false

  allow_node_port_access:
    title: Allow NodePort access
    type: boolean
    default: false
    required: true
    visible: false

  allow_wlsserver_ssh_access:
    title: Allow Weblogic Server SSH access
    type: boolean
    default: true
    required: true
    visible: ${create_nsgs}
  allow_adminserver_ssh_access:
    title: Allow Adminserver Server SSH access
    type: boolean
    default: true
    required: true
    visible: ${create_nsgs}
  allow_wlsserver_internet_access:
    title: Allow Weblogic Server egress to internet
    type: boolean
    default: true
    required: true
    visible: ${create_nsgs}

  allow_bastion_domain_access:
    title: Allow Bastion Server egress Traffic
    type: boolean
    default: true
    required: true

  allow_bastion_adminserver_console_access:
    title: Allow Bastion to access Admin Server Listen Ports
    type: boolean
    default: true
    required: true

  allow_rules_internal_lb:
    title: Additional internal load balancer rules
    additionalProps:
      allowMultiple: true
    required: false

  allow_rules_public_lb:
    title: Additional public load balancer rules
    additionalProps:
      allowMultiple: true
    required: false

  create_drg:
    title: Create DRG
    description: Create a Dynamic Routing Gateway and attach it to the VCN.
    type: boolean
    default: false
    required: false
    visible: false
  drg_id:
    title: Dynamic Routing Gateway
    description: Existing Dynamic Routing Gateway to attach to the VCN.
    type: ocid
    required: false
    visible: false
  drg_display_name:
    title: DRG display name
    visible: ${create_drg}
  enable_waf:
    title: Enable WAF
    type: boolean
    default: false
    required: false
    visible: false

  ########################################################################
  #Bastion

  bastion_subnet_cidr:
    visible:
       and :
            - ${orm_create_mode}
            - ${create_bastion}
    type: string
    default: 10.0.1.0/24
    pattern: "^(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]).(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]).(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]).(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\/(3[0-2]|[1-2]?[0-9])$"
    required: true
    title: "Bastion Host Subnet CIDR"
    description: "The new subnet's CIDR should not overlap with any other subnet CIDRs. In case of an existing VCN, the new subnet's CIDR should not overlap with any other subnet CIDRs."

  bastion_shape:
    title: Bastion Host Shape
    type: oci:core:instanceshapewithflex:name
    default: "{\"instanceShape\":\"VM.Standard.E4.Flex\",\"ocpus\":1,\"memory\":16}"
    required: true
    dependsOn:
      compartmentId: ${compartment_ocid}
    description: The shape for Bastion host.
    visible:
       and :
            - ${orm_create_mode}
            - ${create_bastion}

  create_bastion:
    title: Provision Bastion Instance
    type: boolean
    default: true
    required: true
    description: Provision a bastion compute instance on a public subnet to provide access to the WebLogic Server compute instances on a private subnet.

  # SSH
  ssh_public_key:
    title: SSH Public Key
    type: oci:core:ssh:publickey
    required: true
  ssh_kms_vault_id:
    title: SSH Vault
    description: The OCI Vault where private SSH key pair is stored.
    type: oci:kms:vault:id
    required: true
    dependsOn:
      compartmentId: ${compartment_ocid}
  ssh_kms_secret_id:
    title: SSH Vault secret
    description: The OCI Vault secret containing the SSH private key.
    type: oci:kms:secret:id
    required: true
    dependsOn:
      compartmentId: ${compartment_ocid}
      vaultId: ${ssh_kms_vault_id}


  # Weblogic Domain
  create_domain:
    title: Create Weblogic Managed Servers.
    description: Create Weblogic Managed servers and restore them from archive stored in Object Storage Bucket.
    default : true
    required : false
    visible : false
    type: bool

  ######################################
  #Section: LoadBalancer Configuration
  ######################
  add_load_balancer:
    title: Provision Public Load Balancer
    description: Provision a load balancer in Oracle Cloud Infrastructure to distribute application traffic to the managed servers in the domain.
    default: true
    type: boolean

  use_existing_loadbalancer:
    title: Use existing LoadBalancer
    description: Select an Existing LoadBalancer from Compartment in section "Identity"
    default: false
    type: boolean
    visible: false

  existing_load_balancer_id:
    type: oci:loadbalancer:loadbalancer:id
    #    pattern: ^(10)Mbps.*$
    title: Existing Load Balancer for "Weblogic Domain" migration Evaluation
    required: true
    default: ""
    dependsOn:
      compartmentId: ${compartment_ocid}
    visible: false


  load_balancer_shape:
    type: enum
    title: "Select a shape for the load balancer"
    description: "Note: flexible loadbalancer shape will be the only shape supported for production environments. "
    default: "flexible"
    required: false
    enum:
      - "flexible"
      - "100Mbps"
      - "10Mbps"
      - "10Mbps-Micro"
      - "400Mbps"
      - "8000Mbps"
    visible:
      and:
        - add_load_balancer
        - not: use_existing_loadbalancer

  lb_max_bandwidth:
    title: Flexible Public Load Balancer Max Bandwith
    description: "Choose Maximum Shape for Flex Load Balancer."
    required: false
    type: enum
    default: "100"
    enum:
      - "10"
      - "100"
      - "1000"
      - "400"
      - "8000"
    visible:
      and:
        - and:
            - ${add_load_balancer}
            - not:
                - ${use_existing_loadbalancer}
        - eq:
            - load_balancer_shape
            - "flexible"

  lb_min_bandwidth:
    title: Flexible Public Load Balancer Min Bandwith
    description: "Choose Minimum Shape for Flex Load Balancer."
    required: false
    type: enum
    default: "100"
    enum:
      - "10"
      - "100"
      - "1000"
      - "400"
      - "8000"
    visible:
      and:
        - and:
            - ${add_load_balancer}
            - not:
                - ${use_existing_loadbalancer}
        - eq:
            - load_balancer_shape
            - "flexible"

  pub_lb_subnet_create:
    title: Create public load balancer subnet
    type: boolean
    required: false
    visible:
      and:
        - add_load_balancer
        - not: use_existing_loadbalancer

  pub_lb_subnet_id:
    title: Public load balancer subnet
    type: oci:core:subnet:id
    required: false
    dependsOn:
      compartmentId: ${compartment_ocid}
      vcnId: ${vcn_id}
      hidePublicSubnet: false
      hidePrivateSubnet: true
      hideRegionalSubnet: false
      hideAdSubnet: true
    visible: false

  pub_lb_subnet_cidr:
    title: Load Balancer Subnet CIDR
    description: "The CIDR of the new subnet to create for the load balancer. The new subnet CIDR should not overlap with any other subnet CIDRs."
    type: string
    default: 10.0.3.0/24
    pattern: "^(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])/(3[0-2]|[1-2]?[0-9])$"
    required: true
    visible: ${add_load_balancer}

  int_lb_subnet_create: # Future version
    title: Create internal load balancer subnet
    type: boolean
    required: false
    default: false
    visible: false

  int_lb_subnet_newbits: # Future version
    title: Internal load balancer subnet size
    description: The number of network prefix bits added to the VCN CIDR block for the created subnet address range (i.e. a higher value is smaller). Refer to the Terraform <a href=https://developer.hashicorp.com/terraform/language/functions/cidrsubnets>cidrsubnets</a> function for more information.
    type: number
    visible: ${int_lb_subnet_create}
    required: false

  int_lb_subnet_id:  # Future version
    title: Internal load balancer subnet
    type: oci:core:subnet:id
    required: false
    dependsOn:
      compartmentId: ${compartment_ocid}
      vcnId: ${vcn_id}
      hidePublicSubnet: true
      hidePrivateSubnet: false
      hideRegionalSubnet: false
      hideAdSubnet: true
    visible:
      not: ${int_lb_subnet_create}

  create_demo_certificate:
    title: Install a Test SSL Certificate?
    description: A generated Test certificate will be configured on Loadbalancer port 443/https.
    default: false
    type: boolean
    visible: false

  #########################
  ### End: LoadBalancer Configuration
  #######################################

  # Weblogic Servers
  wlsserver_pool_mode:
    title: Resource type
    description: Type of Oracle Cloud Compute resources for the created Weblogic Servers. Note Other options in future releases
    type: enum
    default: Instances
    enum: [Instances] # Instance Pool
    required: true
    visible: false
  wlsserver_pool_size:
    title: Number of wlsserver nodes
    type: number
    default: 1
    required: true
    visible: false
  wlsserver_shape:
    title: Compute Shape
    type: oci:core:instanceshapewithflex:name
    #type: oci:core:instanceshape:name
    #default: "VM.Standard.E4.Flex"
    default: "{\"instanceShape\":\"VM.Standard.E4.Flex\",\"ocpus\":1,\"memory\":16}"
    required: true
    dependsOn:
      compartmentId: ${compartment_ocid}
      #imageId: ${instance_image_id}
    description: The shape for WebLogic Server compute instances.
  wlsserver_ocpus:
    visible: false
    title: OCPUs
    type: number
    default: 2
    required: false
    description: The number of OCPU count for instances. Only required for VM.Standard.E3.Flex, VM.Standard.E4.Flex, VM.Standard.E5.Flex, VM.Optimized3.Flex, and VM.Standard3.Flex Shapes. The maximum number of ocpus for VM.Standard.E3.Flex and VM.Standard.E4.Flex is 64, for VM.Standard.E5.Flex is 94, while VM.Optimized3.Flex shape supports 18.
  wlsserver_memory:
    visible: false
    title: Memory (GB)
    type: number
    default: 16
    required: false
  wlsserver_boot_volume_size:
    title: Boot volume size (GB)
    type: number
    required: false
    visible: false
  wlsserver_mw_volume_size:
    title: Middleware volume size (GB)
    type: number
    required: false
    visible: false
  wlsserver_jdk_volume_size:
    title: JDK volume size (GB)
    type: number
    required: false
    visible: false
  wlsserver_domain_volume_size:
    title: WebLogic Domain volume size (GB)
    type: number
    required: false
    visible: false
  wlsserver_image_type:
    title: Image License Type
    description: The selected image is used for Weblogic instances.
    type: enum
    default: "Oracle WebLogic Server Enterprise Edition UCM Image"
    enum: ["Oracle WebLogic Server Enterprise Edition UCM Image", "Oracle Weblogic Server Suite UCM Image", "Oracle WebLogic Server Enterprise Edition BYOL Image", "Oracle Weblogic Server Suite BYOL Image", "Platform Image"]
    required: true
    and:
      - ${orm_create_mode}
  wlsserver_image_os:
    title: Operating system
    type: enum
    default: "Oracle Linux"
    enum: ["Oracle Linux"]
    required: true
    visible: false

  wlsserver_image_os_version:
    title: Operating system version
    type: enum
    default: "8"
    enum: ["7.9", "8"]  #TODO: JOI  set os.auto.tfvars os version to values from discovered OS version.
    required: true
    visible: false

  wlsserver_image_id:
    visible: false

  wlsserver_image_custom_id:
    title: Image ID
    type: ocid
    required: true
    pattern: ^ocid1.image.*$
    visible:
      eq:
        - wlsserver_image_type
        - "custom"

  wlsserver_image_platform_id:
    title: Image
    type: oci:core:image:id
    required: true
    pattern: ^ocid1.image.*$
    dependsOn:
      compartmentId: ${compartment_ocid}
      operatingSystem: ${wlsserver_image_os}
      operatingSystemVersion: ${wlsserver_image_os_version}
      shape: ${wlsserver_shape}
    visible: false

  terms_and_conditions:
    visible:
      or:
        - eq:
            - wlsserver_image_type
            - "Oracle WebLogic Server Enterprise Edition UCM Image"
        - eq:
            - wlsserver_image_type
            - "Oracle Weblogic Server Suite UCM Image"
    type: boolean
    default: false
    title: "I have reviewed and accept the Oracle Terms of Use"
    description: "I have reviewed and accept the <a target=\"_blank\" href=\"https://objectstorage.us-phoenix-1.oraclecloud.com/n/axxu7cichsnt/b/terms/o/wlsoci_ee_terms_and_conditions.txt\">Oracle terms of use</a>"
    required: true

  wlsserver_cloud_init:
    visible: false
  wlsserver_cloud_init_configure:
    type: boolean
    title: Custom cloud-init
    description: Override cloud-init for all instances.
    default : false
    visible : false

  wlsserver_cloud_init_byon:
    title: Cloud-init script
    type: text
    multiline: true
    required: false
    description: |
      Custom cloud-init script for wlsserver node startup configuration. Must include the default Weblogic initialization call to join the cluster and begin operation.
    visible:
      and:
        - wlsserver_cloud_init_configure
        - not:
            - eq:
                - wlsserver_pool_mode
                - Node Pool
  wlsserver_cloud_init_wls:
    title: Cloud-init script
    type: text
    multiline: true
    required: false
    description: |
      Custom cloud-init script for self-managed wlsserver node startup configuration. Must uncomment and define the two required parameters and include the default WLS initialization call to join the cluster and begin operation.
    visible:
      and:
        - wlsserver_cloud_init_configure
        - eq:
            - wlsserver_pool_mode
            - Node Pool
  wlsserver_block_volume_type:
    title: Block volume type
    type: enum
    enum: [Paravirtualized, iSCSI]
    default: iSCSI
    required: true
    visible: false
  wlsserver_node_labels:
    title: Node labels
    type: map
    required: false
    visible: false
  wlsserver_use_encryption:
    title: KMS volume encryption
    type: boolean
    default: false
    required: true
    visible: false
  wlsserver_volume_kms_vault_id:
    title: KMS volume encryption vault
    description: Vault containing operator volume encryption keys.
    type: oci:kms:vault:id
    required: false
    dependsOn:
      compartmentId: ${compartment_ocid}
    visible: wlsserver_use_encryption
  wlsserver_volume_kms_key_id:
    title: KMS volume encryption key
    type: oci:kms:key:id
    dependsOn:
      compartmentId: ${compartment_ocid}
      vaultId: ${wlsserver_volume_kms_vault_id}
    required: false
    visible: wlsserver_use_encryption
  wlsserver_pv_transit_encryption:
    title: In-transit volume encryption
    type: boolean
    default: false
    visible:
      eq:
        - wlsserver_block_volume_type
        - Paravirtualized
  wlsserver_tags:
    title: Tagging
    type: oci:identity:tag:value
    required: false
    description: Tag values for created resources.
    dependsOn:
      compartmentId: ${compartment_ocid}
  bucket_name:
    title: Object Storage Bucket name
    type: string
    required: true
    description: OCI Object Storage Bucket name where on-premise Weblogic archives are stored.


  #Datasources
    # Datasources Flags

  update_any_ds:
    type: boolean
    required: false
    visible: false

    {{#datasources}}
  update_ds_{{{datasourceName}}}:
    type: boolean
    required: false
    visible: false
  # ATP DB Configuration
  ds_{{{datasourceName}}}:
    type: text
    title: Unique jdbc connection string discovered
    required: true
    visible:
      and:
        - update_any_ds
        - update_ds_{{{datasourceName}}}

  edit_ds_{{{datasourceName}}}:
    type: boolean
    title: Did the jdbc connection string change after the Database migration to OCI?
    description: Select this option to build the connection string from ATP service, OCI DB System, or Edit String directly.
    required: true
    default: true
    visible:
      and:
        - update_any_ds
        - update_ds_{{{datasourceName}}}

  db_strategy_{{{datasourceName}}}:
    visible:
      and:
        - ${update_any_ds}
        - edit_ds_{{{datasourceName}}}
    type: enum
    title: "Database Strategy"
    description: "Choose the database strategy for WebLogic Server or custom jdbc string"
    enum:
      - "Autonomous Transaction Processing Database"
      - "Database System"
      - "Edit JDBC String"
    default: "Edit JDBC String"
    required: true

  oci_db_connection_string_{{{datasourceName}}}:
    visible:
      and:
        - ${update_any_ds}
        - ${update_ds_{{{datasourceName}}}}
        - edit_ds{{{datasourceName}}}
        - eq:
            - ${db_strategy_{{{datasourceName}}}}
            - "Edit JDBC String"
#        - not:
#            - ${create_vcn}
    type: string
    title: "Oracle Database Connection String"
    description: "Oracle database connection string to connect to database. Example: //{scan_hostname}.{host_domain_name}:{db_port}/{pdb_or_sid}.{Host Domain Name}"
#    pattern: ^(\/\/)
    default: ${ds_{{{datasourceName}}}}
    required: true

  atp_db_network_compartment_id_{{{datasourceName}}}:
    visible:
      and:
        - ${orm_create_mode}
        - ${update_any_ds}
        - ${update_ds_{{{datasourceName}}}}
        - edit_ds_{{{datasourceName}}}
        - and:
            - eq:
                - ${db_strategy_{{{datasourceName}}}}
                - "Autonomous Transaction Processing Database"
            - atp_db_uses_private_endpoint_{{{datasourceName}}}
    type: oci:identity:compartment:id
    required: true
    default: ${compartment_ocid}
    title: "Autonomous Database Network Compartment"
    description: "The compartment in which the Autonomous Transaction Processing(ATP) Database Virtual Cloud Network(VCN) is found."


  atp_db_compartment_id_{{{datasourceName}}}:
    visible:
      and:
        - ${orm_create_mode}
        - ${update_any_ds}
        - edit_ds_{{{datasourceName}}}
        - eq:
            - ${db_strategy_{{{datasourceName}}}}
            - "Autonomous Transaction Processing Database"
    type: oci:identity:compartment:id
    required: true
    default: ${compartment_ocid}
    title: "Autonomous Database Compartment"
    description: "The compartment in which the Autonomous Transaction Processing (ATP) database is found"

  atp_db_id_{{{datasourceName}}}:
    visible:
      and:
        - ${orm_create_mode}
        - ${update_any_ds}
        - edit_ds_{{{datasourceName}}}
        - eq:
            - ${db_strategy_{{{datasourceName}}}}
            - "Autonomous Transaction Processing Database"
    type: oci:database:autonomousdatabase:id
    dependsOn:
      compartmentId: ${atp_db_compartment_id_{{{datasourceName}}}}
    required: true
    title: "Autonomous Database"
    default: ""
    description: "The Autonomous Transaction Processing (ATP) database in which to provision the schemas for a JRF-enabled WebLogic Server domain"

  atp_db_level_{{{datasourceName}}}:
    visible:
      and:
        - ${orm_create_mode}
        - ${update_any_ds}
        - edit_ds_{{{datasourceName}}}
        - eq:
            - ${db_strategy_{{{datasourceName}}}}
            - "Autonomous Transaction Processing Database"
    type: enum
    enum:
      - low
      - tp
      - tpurgent
    default: low
    title: "Autonomous Database Service Level"
    description: "The service level that the WebLogic Server domain should use to connect to the autonomous database. The default is low."

  atp_db_uses_private_endpoint_{{{datasourceName}}}:
    visible:
      and:
        - ${orm_create_mode}
        - ${update_any_ds}
        - edit_ds_{{{datasourceName}}}
        - eq:
            - ${db_strategy_{{{datasourceName}}}}
            - "Autonomous Transaction Processing Database"
    type: boolean
    default: false
    title: "Database uses private endpoint"
    description: "The Autonomous Transaction Processing (ATP) database uses private endpoint for network access"

  atp_db_existing_vcn_id_{{{datasourceName}}}:
    visible:
      and:
        - ${orm_create_mode}
        - ${update_any_ds}
        - edit_ds_{{{datasourceName}}}
        - and:
            - eq:
                - ${db_strategy_{{{datasourceName}}}}
                - "Autonomous Transaction Processing Database"
        - ${atp_db_uses_private_endpoint_{{{datasourceName}}}}
    type: oci:core:vcn:id
    dependsOn:
        compartmentId: ${atp_db_network_compartment_id_{{{datasourceName}}}}
    required: true
    default: ''
    title: "Autonomous Database Network"
    description: "An existing Virtual Cloud Network (VCN) used by ATP database with private endpoint. If the selected VCN is different from WebLogic Server VCN then local VCN peering will be setup. When using VCN peering ensure that the VCNs being peered have non-overlapping CIDR blocks."

  ########
  # End section: ATP
  ########
  ########
  # Start section: Database Service
  ########
  oci_db_network_compartment_id_{{{datasourceName}}}:
    visible:
      and:
        - ${orm_create_mode}
        - ${update_any_ds}
        - edit_ds_{{{datasourceName}}}
        - and:
            - eq:
                - ${db_strategy_{{{datasourceName}}}}
                - "Database System"
#            - or:
#                - ${create_vcn}
#                - not:
#                    - ${use_oci_db_connection_string}
    type: oci:identity:compartment:id
    required: true
    title: "DB System Network Compartment"
    description: "The compartment in which the DB System Virtual Cloud Network is found"
    default: ${compartment_ocid}

  oci_db_existing_vcn_id_{{{datasourceName}}}:
    visible:
        and:
            - ${orm_create_mode}
            - ${update_any_ds}
            - edit_ds_{{{datasourceName}}}
            - and:
                - eq:
                    - ${db_strategy_{{{datasourceName}}}}
                    - "Database System"
    type: oci:core:vcn:id
    dependsOn:
        compartmentId: ${oci_db_network_compartment_id_{{{datasourceName}}}}
    required: true
    default: ''
    title: "DB System Network"
    description: "An existing Virtual Cloud Network (VCN) used by DB System. If the selected VCN is different from WebLogic Server VCN then local VCN peering will be setup. When using VCN peering ensure that the VCNs being peered have non-overlapping CIDR blocks."

  oci_db_compartment_id_{{{datasourceName}}}:
    visible:
      and:
        - ${orm_create_mode}
        - ${update_any_ds}
        - edit_ds{{{datasourceName}}}
        - and:
            - eq:
                - ${db_strategy_{{{datasourceName}}}}
                - "Database System"
#            - or:
#                - ${create_vcn}
#                - not:
#                    - ${use_oci_db_connection_string}
    type: oci:identity:compartment:id
    required: true
    title: "DB System Compartment"
    description: "The compartment in which the DB System is found"
    default: ${compartment_ocid}

  oci_db_dbsystem_id_{{{datasourceName}}}:
    visible:
      and:
        - ${orm_create_mode}
        - ${update_any_ds}
        - edit_ds_{{{datasourceName}}}
        - and:
            - eq:
                - ${db_strategy_{{{datasourceName}}}}
                - "Database System"
#            - or:
#                - ${create_vcn}
#                - not:
#                    - ${use_oci_db_connection_string}
    type: oci:database:dbsystem:id
    dependsOn:
      compartmentId: ${oci_db_compartment_id_{{{datasourceName}}}}
    required: true
    title: "DB System"
    description: "The Oracle Cloud Infrastructure DB System to use for this WebLogic Server domain"

  oci_db_dbhome_id_{{{datasourceName}}}:
    visible:
      and:
        - ${orm_create_mode}
        - ${update_any_ds}
        - edit_ds_{{{datasourceName}}}
        - and:
            - eq:
                - ${db_strategy_{{{datasourceName}}}}
                - "Database System"
#            - or:
#                - ${create_vcn}
#                - not:
#                    - ${use_oci_db_connection_string}
    type: oci:database:dbhome:id
    required: true
    title: "Database home in the DB System"
    description: "The database home within the DB System"
    dependsOn:
      compartmentId: ${oci_db_compartment_id_{{{datasourceName}}}}
      dbSystemId: ${oci_db_dbsystem_id_{{{datasourceName}}}}

  oci_db_dbhome_major_version_{{{datasourceName}}}:
    visible:
      and:
        - ${orm_create_mode}
        - ${update_any_ds}
        - edit_ds_{{{datasourceName}}}
        - and:
            - eq:
                - ${db_strategy_{{{datasourceName}}}}
                - "Database System"
#            - or:
#                - ${create_vcn}
#                - not:
#                    - ${use_oci_db_connection_string}
    type: oci:database:dbhome:dbversion
    title: "Version of Database home in the DB System"
    description: "The version of database home within the DB System"
    dependsOn:
      dbHomeId: ${oci_db_dbhome_id_{{{datasourceName}}}}

  oci_db_database_id_{{{datasourceName}}}:
    visible:
      and:
        - ${orm_create_mode}
        - ${update_any_ds}
        - edit_ds_{{{datasourceName}}}
        - and:
            - eq:
                - ${db_strategy_{{{datasourceName}}}}
                - "Database System"
#            - or:
#                - ${create_vcn}
#                - not:
#                    - ${use_oci_db_connection_string}
    type: oci:database:database:id
    dependsOn:
      compartmentId: ${oci_db_compartment_id_{{{datasourceName}}}}
      dbHomeId: ${oci_db_dbhome_id_{{{datasourceName}}}}
    required: true
    title: "Database in the DB System"
    description: "The database within the DB System"

  oci_db_pdb_service_name_{{{datasourceName}}}:
    visible:
      and:
        - ${orm_create_mode}
        - ${update_any_ds}
        - edit_ds_{{{datasourceName}}}
        - and:
            - not:
                - eq:
                    - ${oci_db_dbhome_major_version_{{{datasourceName}}}}
                    - "11"
            - eq:
                - ${db_strategy_{{{datasourceName}}}}
                - "Database System"

    type: string
    required: true
    title: "PDB"
    description: "The name of the pluggable database (PDB) in which schemas were provisioned already. This is required for Oracle Database 12c or later."

  oci_db_port_{{{datasourceName}}}:
    visible:
      and:
        - ${orm_create_mode}
        - ${update_any_ds}
        - edit_ds_{{{datasourceName}}}
        - and:
            - eq:
                - ${db_strategy_{{{datasourceName}}}}
                - "Database System"
#            - or:
#                - ${create_vcn}
#                - not:
#                    - ${use_oci_db_connection_string}
    type: integer
    default: 1521
    title: "Database Listener Port"
    description: "The Listener Port for the Database"
    required: false
  ########
  # End section: Database Service
  ########
